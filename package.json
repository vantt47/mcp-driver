{
  "name": "mcp-platform",
  "version": "2.0.0",
  "description": "MCP server setup key/config đa nền tảng: Google Cloud, Firebase, Cloudflare, GitHub, Apple, Google Drive",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-platform": "dist/index.js",
    "mcp-gdrive": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "auth": "npm run build && node dist/providers/gdrive/authorize.js",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "inspector": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build",
    "check": "npm run build && node dist/index.js --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^178.0.0",
    "libsodium-wrappers": "^0.7.15",
    "open": "^10.1.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "google-auth-library": "$google-auth-library"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
