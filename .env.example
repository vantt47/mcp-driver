# ---------------------------------------------------------------------------
# mcp-platform — biến môi trường
# Copy thành `.env` rồi điền. Biến trong "env" của config MCP luôn được ưu tiên hơn file này.
# Trên Windows, nếu process không thấy biến, server tự đọc từ biến môi trường User (HKCU\Environment).
# ---------------------------------------------------------------------------

# Chọn provider (mặc định all): gcp, firebase, cloudflare, github, apple, gdrive
# MCP_PROVIDERS=all

# Chặn mọi thao tác ghi/tạo/xoá ở tầng server
# MCP_READ_ONLY=false

# --- Google Cloud + Firebase (Application Default Credentials) -------------
# Cách 1: gcloud auth application-default login
# Cách 2: file JSON của service account
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
# Project mặc định khi tool không truyền project_id
# GCP_PROJECT_ID=my-project
# (Tuỳ chọn) Ép một quota project cố định. Mặc định: tính vào project đang thao tác
# GCP_QUOTA_PROJECT=my-project

# --- Cloudflare -------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- GitHub (cần quyền repo + Actions secrets) -------------------------------
# GITHUB_TOKEN=          (hoặc GITHUB_CLASSIC_TOKEN)

# --- Apple App Store Connect API --------------------------------------------
# Tạo tại App Store Connect → Users and Access → Integrations → App Store Connect API
# ASC_KEY_ID=ABC123DEFG
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_PRIVATE_KEY_PATH=C:/keys/AuthKey_ABC123DEFG.p8

# --- Google Drive (OAuth Desktop app) ---------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# GDRIVE_TOKEN_PATH=~/.mcp-gdrive/token.json
# GDRIVE_OAUTH_PORT=0
# GDRIVE_SCOPES=https://www.googleapis.com/auth/drive
# GDRIVE_ROOT_FOLDER_ID=
# GDRIVE_READ_ONLY=false
# GDRIVE_MAX_READ_BYTES=1000000
