# ---------------------------------------------------------------------------
# MCP Google Drive — biến môi trường
# Copy file này thành `.env` rồi điền giá trị thật.
# ---------------------------------------------------------------------------

# OAuth Client ID / Secret của loại "Desktop app"
# Lấy tại: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# (Tuỳ chọn) Nơi lưu refresh token sau khi đăng nhập.
# Mặc định: ~/.mcp-gdrive/token.json
# GDRIVE_TOKEN_PATH=/Users/ban/.mcp-gdrive/token.json

# (Tuỳ chọn) Cổng loopback dùng cho OAuth callback. Mặc định: 0 = tự chọn cổng trống.
# Nếu bạn muốn cố định, hãy thêm http://localhost:53682/oauth2callback vào
# "Authorized redirect URIs" của OAuth client.
# GDRIVE_OAUTH_PORT=53682

# (Tuỳ chọn) Scope. Mặc định là quyền đầy đủ trên Drive:
#   https://www.googleapis.com/auth/drive
# Nếu chỉ cần đọc, đổi thành: https://www.googleapis.com/auth/drive.readonly
# Nếu chỉ muốn server thấy các file do chính nó tạo/mở:
#   https://www.googleapis.com/auth/drive.file
# GDRIVE_SCOPES=https://www.googleapis.com/auth/drive

# (Tuỳ chọn) Giới hạn mọi thao tác trong 1 folder gốc (ID folder trên Drive).
# Khi đặt, search mặc định chỉ tìm trong cây folder này và create mặc định ghi vào đây.
# GDRIVE_ROOT_FOLDER_ID=

# (Tuỳ chọn) Chế độ chỉ-đọc: chặn tool create/update ở tầng server.
# GDRIVE_READ_ONLY=false

# (Tuỳ chọn) Số byte tối đa trả về cho 1 lần gdrive_read. Mặc định 1000000 (~1MB).
# GDRIVE_MAX_READ_BYTES=1000000
